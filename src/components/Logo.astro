---
import type { Lang } from '@/i18n/ui';
import { localizedPath } from '@/i18n/routes';
import { site } from '@/lib/site';
import { l } from '@/lib/text';

interface Props { lang: Lang; inverted?: boolean }
const { lang, inverted = false } = Astro.props;
const name = l(site.name, lang);
---
<a href={localizedPath(lang, '/')} class="group inline-flex items-center gap-2.5 rounded-lg" aria-label={`${l(site.fullName, lang)} — ${lang === 'uk' ? 'на головну' : lang === 'pl' ? 'strona główna' : 'home'}`}>
  <svg viewBox="0 0 40 40" class="size-10 shrink-0" aria-hidden="true">
    <rect width="40" height="40" rx="10" fill={inverted ? '#ffffff' : '#22399b'} />
    <path d="M10 10h5v5h-5zM20 10h5v5h-5zM15 15h5v5h-5zM10 20h5v5h-5z" fill={inverted ? '#bfcfff' : '#3d63dd'} />
    <g transform="translate(8 7.5)" fill="#ffd54a" stroke="#121b3d" stroke-width="1.3" stroke-linejoin="round"><path d="M8 19c.3-2.5 1.3-4.3 2.5-6l-3.7 1.4-2.3-1.9.7-2.5 4-3.6L9 3l2.6 1.6C15.8 5 18 8.6 18 13v6H8Z" /><path d="M6 22h12a1 1 0 0 0 1-1v-.5a1.5 1.5 0 0 0-1.5-1.5h-11A1.5 1.5 0 0 0 5 20.5v.5a1 1 0 0 0 1 1Z" /><circle cx="10.4" cy="8.4" r=".9" fill="#121b3d" stroke="none" /></g>
  </svg>
  <span class:list={['font-display text-xl font-bold tracking-tight', inverted ? 'text-white' : 'text-brand-950']}>{name}</span>
</a>

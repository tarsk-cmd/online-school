---
/** Яскравий блок-запрошення до шахового тренажера (головна сторінка). */
import { localizedPath } from '@/i18n/routes';
import { mascotSvg } from './mascot';

interface Props { lang?: 'uk' | 'pl' }
const { lang = 'uk' } = Astro.props;
const TEXT = {
  uk: {
    kicker: 'Нове · для дітей 7–12 років',
    title: 'Спробуй шаховий тренажер безкоштовно',
    lead: 'Як ходять фігури, шах, втечі від шаху й мат в 1 хід — у грі зі зірочками, балами й нагородами. Без реєстрації й реклами, працює на телефоні.',
    button: 'Грати',
  },
  pl: {
    kicker: 'Nowość · dla dzieci 7–12 lat',
    title: 'Wypróbuj trener szachowy za darmo',
    lead: 'Jak chodzą bierki, szach, ucieczka przed szachem i mat w 1 ruchu — w grze z gwiazdkami, punktami i odznakami. Bez rejestracji i reklam, działa na telefonie.',
    button: 'Graj',
  },
}[lang];
---
<section class="section pt-4 pb-0 sm:pt-6 sm:pb-0" aria-labelledby="trainer-promo-title">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl border-4 border-sun-400 bg-gradient-to-br from-sun-200 via-white to-brand-50 p-6 shadow-sm sm:p-10">
      <div class="grid items-center gap-6 sm:grid-cols-[auto_1fr_auto]">
        <div class="mx-auto w-24 sm:w-32" set:html={mascotSvg} />
        <div>
          <p class="eyebrow">{TEXT.kicker}</p>
          <h2 id="trainer-promo-title" class="mt-2 text-2xl font-bold sm:text-3xl">{TEXT.title}</h2>
          <p class="mt-3 text-muted">{TEXT.lead}</p>
        </div>
        <a href={localizedPath(lang, '/trener/')} class="btn-primary text-lg">{TEXT.button} ♞</a>
      </div>
    </div>
  </div>
</section>

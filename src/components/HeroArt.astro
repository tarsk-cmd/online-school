---
// Декоративна ілюстрація першого екрана: шахова дошка + плитки напрямів
import Icon from './Icon.astro';
const tiles = [
  { icon: 'languages', cls: 'bg-teal-700 text-white', pos: 'top-2 -left-2 sm:-left-6' },
  { icon: 'math', cls: 'bg-violet-600 text-white', pos: 'top-1/3 -right-3 sm:-right-6' },
  { icon: 'music', cls: 'bg-rose-600 text-white', pos: 'bottom-6 -left-3 sm:-left-8' },
  { icon: 'it', cls: 'bg-emerald-700 text-white', pos: '-bottom-4 right-10' },
];
---
<div class="relative mx-auto w-full max-w-[260px] sm:max-w-md" aria-hidden="true">
  <div class="rotate-3 rounded-[2rem] bg-white p-4 shadow-xl ring-1 ring-slate-200">
    <svg viewBox="0 0 160 160" class="w-full rounded-2xl">
      {Array.from({ length: 64 }, (_, i) => {
        const x = i % 8, y = Math.floor(i / 8);
        return <rect x={x * 20} y={y * 20} width="20" height="20" fill={(x + y) % 2 ? '#22399b' : '#eef3ff'} />;
      })}
      <g transform="translate(56 52) scale(2)" fill="#ffd54a" stroke="#121b3d" stroke-width="0.9" stroke-linejoin="round"><path d="M8 19c.3-2.5 1.3-4.3 2.5-6l-3.7 1.4-2.3-1.9.7-2.5 4-3.6L9 3l2.6 1.6C15.8 5 18 8.6 18 13v6H8Z" /><path d="M6 22h12a1 1 0 0 0 1-1v-.5a1.5 1.5 0 0 0-1.5-1.5h-11A1.5 1.5 0 0 0 5 20.5v.5a1 1 0 0 0 1 1Z" /><circle cx="10.4" cy="8.4" r=".8" fill="#121b3d" stroke="none" /></g>
      <circle cx="30" cy="130" r="6" fill="#f2712f" />
      <circle cx="130" cy="30" r="6" fill="#f2712f" />
    </svg>
  </div>
  {tiles.map((t) => (
    <span class:list={['absolute grid size-14 place-items-center rounded-2xl shadow-lg sm:size-16', t.cls, t.pos]}>
      <Icon name={t.icon} class="size-8" />
    </span>
  ))}
</div>

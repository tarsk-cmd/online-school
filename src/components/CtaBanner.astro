---
import { useTranslations, type Lang } from '@/i18n/ui';
import { localizedPath } from '@/i18n/routes';
import MessengerButtons from './MessengerButtons.astro';

interface Props { lang: Lang; title?: string; lead?: string; direction?: string }
const { lang, title, lead, direction } = Astro.props;
const t = useTranslations(lang);
const href = localizedPath(lang, `/contacts/${direction ? `?direction=${direction}` : ''}#signup`);
---
<section class="section" aria-labelledby="cta-title">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-brand-800 px-6 py-10 text-white sm:px-12 sm:py-14">
      <svg class="pointer-events-none absolute -top-6 -right-6 size-48 opacity-15 sm:size-72" viewBox="0 0 80 80" aria-hidden="true">
        {Array.from({ length: 16 }, (_, i) => (
          <rect x={(i % 4) * 20 + ((Math.floor(i / 4) % 2) * 10)} y={Math.floor(i / 4) * 20} width="10" height="10" fill="#fff" />
        ))}
        {Array.from({ length: 16 }, (_, i) => (
          <rect x={(i % 4) * 20 + (((Math.floor(i / 4) + 1) % 2) * 10)} y={Math.floor(i / 4) * 20 + 10} width="10" height="10" fill="#fff" />
        ))}
      </svg>
      <div class="relative max-w-2xl">
        <h2 id="cta-title" class="text-3xl font-bold text-white sm:text-4xl">{title ?? t('home.final.title')}</h2>
        <p class="mt-4 text-lg text-brand-100">{lead ?? t('home.final.lead')}</p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={href} class="btn bg-sun-400 text-ink shadow-sm hover:bg-sun-200">{t('cta.trial')}</a>
          <MessengerButtons lang={lang} variant="dark" />
        </div>
      </div>
    </div>
  </div>
</section>

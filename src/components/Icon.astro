---
/**
 * Прості SVG-іконки напрямів та інтерфейсу. Колір береться з currentColor.
 * Використання: <Icon name="chess" class="size-8" />
 */
interface Props {
  name: string;
  class?: string;
  label?: string;
}
const { name, class: className = 'size-6', label } = Astro.props;

const paths: Record<string, string> = {
  // Шаховий кінь
  chess:
    '<path d="M7 21h10M8 18h8l-1-4c2-1.5 3-3.5 3-6 0-2.5-2-5-5.5-5L10 2v2.2C7.6 5 6 7.3 6 9.5l2.5.8L11 8.8 9 13l-1 5Z" /><circle cx="12.4" cy="6.6" r=".6" fill="currentColor" stroke="none" />',
  // Два «бульбашки» діалогу
  languages:
    '<path d="M4 5h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /><path d="M16 9h4a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1v3l-4-3h-3a2 2 0 0 1-2-2v-1" /><path d="M6 9.5h6M6 11.5h4" />',
  // Плюс, мінус, множення, дорівнює
  math: '<rect x="3" y="3" width="18" height="18" rx="3" /><path d="M7.5 6.5v4M5.5 8.5h4M14.5 8.5h4M6 15l3 3M9 15l-3 3M14.5 15.5h4M14.5 17.5h4" />',
  // Ноти
  music: '<path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" />',
  // Кутові дужки коду
  it: '<rect x="2" y="4" width="20" height="14" rx="2" /><path d="m9 9-2.5 2.5L9 14M15 9l2.5 2.5L15 14M12.8 8.5l-1.6 6M8 21h8" />',
  // Академічна шапочка
  exams: '<path d="m2 9 10-5 10 5-10 5L2 9Z" /><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5M22 9v6" />',

  check: '<path d="m5 12.5 4.5 4.5L19 7.5" />',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6" />',
  menu: '<path d="M4 7h16M4 12h16M4 17h16" />',
  close: '<path d="M6 6l12 12M18 6 6 18" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />',
  users: '<circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.5-3.5 3.2-5.5 6.5-5.5s6 2 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18 14.8c2 .7 3.2 2.5 3.5 5.2" />',
  user: '<circle cx="12" cy="8" r="4" /><path d="M4 21c.6-4 3.8-6.5 8-6.5s7.4 2.5 8 6.5" />',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />',
  shield: '<path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6l-8-3Z" /><path d="m8.5 12 2.5 2.5 4.5-5" />',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />',
  laptop: '<rect x="4" y="4" width="16" height="11" rx="1.5" /><path d="M2 19h20" />',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z" />',
  heart: '<path d="M12 20s-7.5-4.6-9-9.3C2 7.4 4.2 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.8 1.1-1.7 2.7-2.8 4.7-2.8 3.1 0 5.3 2.9 4.3 6.2C19.5 15.4 12 20 12 20Z" />',
  target: '<circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" fill="currentColor" />',
  phone: '<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />',
  chat: '<path d="M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H9l-5 4v-4H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" />',
  sparkle: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6" />',
  book: '<path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H20v15H5.5A1.5 1.5 0 0 0 4 19.5v-15Z" /><path d="M4 19.5A1.5 1.5 0 0 0 5.5 21H20v-3" /><path d="M8 7h8" />',
  globe: '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z" />',
  // Месенджери (спрощені логотипи-символи)
  telegram: '<path d="M21 4 3 11l6 2 2 6 3-4 5 4 2-15Z" /><path d="m9 13 9-6" />',
  viber: '<path d="M12 3c5 0 8 2.5 8 7.5S17 18 12 18l-3 3v-3.4C5.5 16.7 4 14 4 10.5 4 5.5 7 3 12 3Z" /><path d="M9.5 8c0 3 2.5 5.5 5.5 5.5l.7-1.4-1.6-1-.9.7a3.5 3.5 0 0 1-2-2l.7-.9-1-1.6L9.5 8Z" />',
  whatsapp: '<path d="M4 20l1.3-4A8 8 0 1 1 8 18.8L4 20Z" /><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l.8-1.5-1.8-1-.9.8a3.5 3.5 0 0 1-2.4-2.4l.8-.9-1-1.8L9 8.5Z" />',
};

const svg = paths[name] ?? paths.sparkle;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={svg}
/>

---
import { useTranslations, type Lang } from '@/i18n/ui';
import { withBase } from '@/i18n/routes';
import { initials } from '@/lib/text';
import type { Teacher } from '@/lib/content';

interface Props { teacher: Teacher; lang: Lang; compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { teacher, lang, compact = false, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const d = teacher.data;
const ini = initials(d.name);
const palette = ['#22399b', '#0f766e', '#7c3aed', '#be123c', '#047857', '#b45309'];
const color = palette[(d.order - 1) % palette.length];
const H = headingLevel;
---
<article class="card flex h-full flex-col overflow-hidden">
  <div class="relative aspect-[4/3] bg-brand-50">
    {d.photo ? (
      <img src={withBase(d.photo)} alt={d.name} class="size-full object-cover" loading="lazy" decoding="async" width="400" height="300" />
    ) : (
      <svg viewBox="0 0 400 300" class="size-full" role="img" aria-label={`${t('teacher.photoPlaceholder')}: ${d.name}`}>
        <rect width="400" height="300" fill={color} opacity="0.12" />
        <circle cx="200" cy="125" r="62" fill={color} opacity="0.9" />
        <text x="200" y="146" text-anchor="middle" font-size="56" font-family="Rubik Variable, sans-serif" font-weight="700" fill="#fff">{ini === '?' ? '' : ini}</text>
        {ini === '?' && <path d="M200 95a22 22 0 1 1 0 44 22 22 0 0 1 0-44Zm-38 70c6-14 21-22 38-22s32 8 38 22" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round" transform="translate(0 -12)" />}
        <rect x="120" y="220" width="160" height="14" rx="7" fill={color} opacity="0.35" />
        <rect x="150" y="246" width="100" height="10" rx="5" fill={color} opacity="0.2" />
      </svg>
    )}
    {d.founder && <span class="absolute top-3 left-3 rounded-full bg-sun-400 px-3 py-1 text-xs font-bold text-ink">{t('teacher.founder')}</span>}
  </div>
  <div class="flex grow flex-col p-5">
    <H class="text-lg font-bold">{d.name}</H>
    <p class="mt-1 font-medium text-accent-600">{d.role}</p>
    {!compact && <p class="mt-3 grow text-muted">{d.bio}</p>}
    <dl class="mt-4 space-y-2 text-sm">
      <div><dt class="inline font-semibold">{t('teacher.experience')}: </dt><dd class="inline text-muted">{d.experience}</dd></div>
      <div><dt class="inline font-semibold">{t('teacher.subjects')}: </dt><dd class="inline text-muted">{d.subjects.join(', ')}</dd></div>
      {!compact && <div><dt class="inline font-semibold">{t('teacher.languages')}: </dt><dd class="inline text-muted">{d.teachingLanguages.join(', ')}</dd></div>}
      {!compact && d.education && <div><dt class="inline font-semibold">{t('teacher.education')}: </dt><dd class="inline text-muted">{d.education}</dd></div>}
    </dl>
  </div>
</article>

---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; id?: string; level?: 'h1' | 'h2' }
const { eyebrow, title, lead, center = false, id, level = 'h2' } = Astro.props;
const Tag = level;
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class:list={[level === 'h1' ? 'text-4xl font-bold sm:text-5xl' : 'h2', eyebrow && 'mt-2']}>{title}</Tag>
  {lead && <p class="lead mt-4">{lead}</p>}
</div>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n/ui';
import { localizedPath } from '@/i18n/routes';
import { site } from '@/lib/site';
import { l } from '@/lib/text';
import { getDirections, getTeachers } from '@/lib/content';
import SectionHeading from '@/components/SectionHeading.astro';
import DirectionCard from '@/components/DirectionCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import HeroArt from '@/components/HeroArt.astro';
import Icon from '@/components/Icon.astro';
import TrainerPromo from '@/components/trainer/TrainerPromo.astro';
import home from '../../content/home.json';
import faq from '../../content/faq.json';
import reviews from '../../content/reviews.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const directions = await getDirections();
const teachers = (await getTeachers()).slice(0, 3);
const steps = home.steps[lang] ?? home.steps.uk;
const advantages = home.advantages[lang] ?? home.advantages.uk;
const faqItems = faq[lang] ?? faq.uk;
const dirTitle = Object.fromEntries(directions.map((d) => [d.id, l(d.data.title, lang)]));
---
<BaseLayout title={`${l(site.fullName, lang)} — ${l(site.slogan, lang)}`} description={t('home.hero.lead')} lang={lang}>
  <!-- Перший екран -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-paper">
    <div class="container-page grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[1.15fr_1fr] lg:py-24">
      <div>
        <p class="eyebrow">{t('home.hero.kicker')}</p>
        <h1 class="mt-3 text-[2rem] leading-tight font-bold sm:text-5xl lg:text-[2.9rem]">{t('home.hero.title')}</h1>
        <p class="lead mt-5 max-w-2xl">{t('home.hero.lead')}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={localizedPath(lang, '/contacts/#signup')} class="btn-primary text-lg">{t('cta.trial')}</a>
          <a href="#directions" class="btn-secondary">{t('home.hero.secondary')}</a>
        </div>
        <ul class="mt-8 grid gap-3 text-[15px] font-medium sm:grid-cols-3">
          {['home.hero.point1', 'home.hero.point2', 'home.hero.point3'].map((k) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-emerald-100 text-emerald-800"><Icon name="check" class="size-4" /></span>
              {t(k as 'home.hero.point1')}
            </li>
          ))}
        </ul>
      </div>
      <div class="px-6 sm:px-10"><HeroArt /></div>
    </div>
  </section>

  <!-- Шаховий тренажер (українською й польською) -->
  {(lang === 'uk' || lang === 'pl') && <TrainerPromo lang={lang} />}

  <!-- Напрями -->
  <section class="section" aria-labelledby="directions">
    <div class="container-page">
      <SectionHeading id="directions" title={t('home.directions.title')} lead={t('home.directions.lead')} />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {directions.map((d) => <li><DirectionCard direction={d} lang={lang} /></li>)}
      </ul>
      <div class="mt-8">
        <a href={localizedPath(lang, '/courses/')} class="btn-secondary">{t('cta.allCourses')} <Icon name="arrow" class="size-5" /></a>
      </div>
    </div>
  </section>

  <!-- Як проходить навчання -->
  <section class="section bg-white" aria-labelledby="steps">
    <div class="container-page">
      <SectionHeading id="steps" title={t('home.steps.title')} />
      <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="relative rounded-2xl border border-slate-200 bg-paper p-6">
            <span class="font-display grid size-12 place-items-center rounded-full bg-brand-700 text-xl font-bold text-white" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Переваги -->
  <section class="section" aria-labelledby="advantages">
    <div class="container-page">
      <SectionHeading id="advantages" title={t('home.advantages.title')} />
      <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {advantages.map((a) => (
          <li class="flex gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-sun-200 text-brand-900"><Icon name={a.icon} class="size-6" /></span>
            <div>
              <h3 class="text-lg font-bold">{a.title}</h3>
              <p class="mt-1 text-muted">{a.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Викладачі -->
  <section class="section bg-white" aria-labelledby="teachers">
    <div class="container-page">
      <SectionHeading id="teachers" title={t('home.teachers.title')} lead={t('home.teachers.lead')} />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {teachers.map((tc) => <li><TeacherCard teacher={tc} lang={lang} compact /></li>)}
      </ul>
      <div class="mt-8">
        <a href={localizedPath(lang, '/teachers/')} class="btn-secondary">{t('cta.allTeachers')} <Icon name="arrow" class="size-5" /></a>
      </div>
    </div>
  </section>

  <!-- Відгуки -->
  <section class="section" aria-labelledby="reviews">
    <div class="container-page">
      <SectionHeading id="reviews" title={t('home.reviews.title')} />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {reviews.items.map((r) => (
          <li>
            <figure class="card flex h-full flex-col p-6">
              <div class="flex gap-1 text-sun-400" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="size-5 fill-current" />)}</div>
              <blockquote class="mt-4 grow text-ink">«{r.text}»</blockquote>
              <figcaption class="mt-5 text-sm">
                <span class="font-semibold text-brand-950">{r.author}</span>
                <span class="text-muted"> · {r.child} · {dirTitle[r.direction] ?? ''}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white" aria-labelledby="faq">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_2fr]">
      <SectionHeading id="faq" title={t('home.faq.title')} />
      <FaqList items={faqItems} />
    </div>
  </section>

  <CtaBanner lang={lang} />
</BaseLayout>

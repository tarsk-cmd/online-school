---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n/ui';
import { l } from '@/lib/text';
import { getCourses, getDirections } from '@/lib/content';
import { AGE_GROUPS, FORMATS, LEVELS } from '@/lib/taxonomy';
import PageHeader from '@/components/PageHeader.astro';
import CourseCard from '@/components/CourseCard.astro';
import CtaBanner from '@/components/CtaBanner.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const directions = await getDirections();
const courses = await getCourses();
const dirById = new Map(directions.map((d) => [d.id, d]));

const groups = [
  { key: 'age', label: t('catalog.age'), options: AGE_GROUPS.map((a) => ({ value: a, label: `${a.replace('-', '–')} ${t('catalog.years')}` })) },
  { key: 'subject', label: t('catalog.subject'), options: directions.map((d) => ({ value: d.id, label: l(d.data.title, lang) })) },
  { key: 'format', label: t('catalog.format'), options: FORMATS.map((f) => ({ value: f, label: t(`format.${f}`) })) },
  { key: 'level', label: t('catalog.level'), options: LEVELS.map((lv) => ({ value: lv, label: t(`level.${lv}`) })) },
];
---
<BaseLayout title={t('catalog.title')} description={t('catalog.lead')} lang={lang}>
  <PageHeader lang={lang} title={t('catalog.title')} lead={t('catalog.lead')} crumbs={[{ label: t('catalog.title') }]} />

  <section class="section pt-8 sm:pt-10">
    <div class="container-page grid gap-8 lg:grid-cols-[280px_1fr]">
      <form class="lg:sticky lg:top-20 lg:self-start" data-filters aria-labelledby="filters-title">
        <details class="group rounded-2xl border border-slate-200 bg-white p-4 lg:border-0 lg:bg-transparent lg:p-0" data-filters-details>
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 lg:pointer-events-none [&::-webkit-details-marker]:hidden">
          <h2 id="filters-title" class="text-xl font-bold">{t('catalog.filters')} <span class="text-base font-medium text-muted" data-active-count></span></h2>
          <span class="grid size-9 place-items-center rounded-full bg-brand-50 text-brand-800 transition-transform group-open:rotate-180 lg:hidden" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
          {groups.map((g) => (
            <fieldset>
              <legend class="font-semibold text-brand-950">{g.label}</legend>
              <div class="mt-2 flex flex-wrap gap-2">
                {g.options.map((o) => (
                  <label class="relative inline-flex min-h-11 cursor-pointer items-center rounded-full border border-slate-300 bg-white px-4 text-[15px] font-medium select-none has-[:checked]:border-brand-700 has-[:checked]:bg-brand-700 has-[:checked]:text-white has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand-600">
                    <input type="checkbox" name={g.key} value={o.value} class="sr-only" />
                    {o.label}
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
        <button type="reset" class="btn-ghost mt-5 min-h-11 px-3 underline">{t('catalog.reset')}</button>
        </details>
      </form>

      <div>
        <p class="mb-4 font-medium text-muted" role="status" aria-live="polite">
          {t('catalog.found')} <span data-count>{courses.length}</span>
        </p>
        <ul class="grid gap-5 md:grid-cols-2" data-course-list>
          {courses.map((c) => {
            const d = dirById.get(c.data.direction.id)!;
            return <li><CourseCard course={c} direction={d} lang={lang} headingLevel="h2" /></li>;
          })}
        </ul>
        <p class="card hidden p-6 text-muted" data-empty>{t('catalog.empty')}</p>
      </div>
    </div>
  </section>

  <CtaBanner lang={lang} />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-course]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const keys = ['age', 'subject', 'format', 'level'] as const;

  function apply() {
    if (!form) return;
    const fd = new FormData(form);
    const selected = Object.fromEntries(keys.map((k) => [k, fd.getAll(k).map(String)]));
    let visible = 0;
    for (const el of items) {
      // Усередині групи — «або», між групами — «і». Порожня група = будь-яке значення.
      const ok = keys.every((k) => {
        const want = selected[k];
        if (!want.length) return true;
        const has = (el.dataset[k] ?? '').split(' ');
        return want.some((w) => has.includes(w));
      });
      el.closest('li')!.hidden = !ok;
      if (ok) visible++;
    }
    if (count) count.textContent = String(visible);
    const active = keys.reduce((n, k) => n + selected[k].length, 0);
    const badge = document.querySelector<HTMLElement>('[data-active-count]');
    if (badge) badge.textContent = active ? `(${active})` : '';
    empty?.classList.toggle('hidden', visible > 0);

    const params = new URLSearchParams();
    keys.forEach((k) => selected[k].forEach((v) => params.append(k, v)));
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  // На десктопі фільтри завжди розгорнуті, на телефоні — згорнуті, щоб одразу було видно курси
  const details = document.querySelector<HTMLDetailsElement>('[data-filters-details]');
  const mq = window.matchMedia('(min-width: 1024px)');
  const syncOpen = () => { if (details) details.open = mq.matches; };
  syncOpen();
  mq.addEventListener('change', syncOpen);
  details?.querySelector('summary')?.addEventListener('click', (e) => { if (mq.matches) e.preventDefault(); });

  if (form) {
    // Початкові фільтри з адреси: /courses/?subject=chess&age=6-8
    const params = new URLSearchParams(location.search);
    keys.forEach((k) =>
      params.getAll(k).forEach((v) => {
        const input = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(v)}"]`);
        if (input) input.checked = true;
      }),
    );
    form.addEventListener('change', apply);
    form.addEventListener('reset', () => setTimeout(apply));
    apply();
  }
</script>

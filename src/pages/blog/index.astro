---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/ui';
import { localizedPath } from '@/i18n/routes';
import { formatDate } from '@/lib/text';
import { getPosts } from '@/lib/content';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';

const lang = 'uk' as const;
const t = useTranslations(lang);
const posts = await getPosts();
---
<BaseLayout title={t('blog.title')} description={t('blog.lead')} lang={lang}>
  <PageHeader lang={lang} title={t('blog.title')} lead={t('blog.lead')} crumbs={[{ label: t('blog.title') }]} />
  <section class="section pt-10">
    <div class="container-page">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <li>
            <article class="card relative flex h-full flex-col p-6">
              <p class="text-sm text-muted"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>{p.data.readingTime && ` · ${p.data.readingTime}`}</p>
              <h2 class="mt-3 text-xl font-bold"><a href={localizedPath(lang, `/blog/${p.id}/`)} class="after:absolute after:inset-0">{p.data.title}</a></h2>
              <p class="mt-2 grow text-muted">{p.data.description}</p>
              <p class="mt-5 inline-flex items-center gap-1 font-semibold text-brand-700" aria-hidden="true">{t('cta.readMore')} <Icon name="arrow" class="size-4" /></p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/ui';
import { localizedPath } from '@/i18n/routes';
const t = useTranslations('uk');
---
<BaseLayout title={t('notFound.title')} description={t('notFound.lead')} lang="uk" noindex>
  <section class="section">
    <div class="container-page max-w-2xl text-center">
      <p class="font-display text-7xl font-bold text-brand-200" aria-hidden="true">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{t('notFound.title')}</h1>
      <p class="lead mt-4">{t('notFound.lead')}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizedPath('uk', '/')} class="btn-primary">{t('nav.home')}</a>
        <a href={localizedPath('uk', '/courses/')} class="btn-secondary">{t('cta.allCourses')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
